              "name": "loginOrRegister",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "pm.environment.set(\"timestamp\", new Date().getTime());",
                      "",
                      "// 生成三个随机数字，并设置为全局变量",
                      "pm.globals.set(\"randomNum1\", _.random(0, 9));",
                      "pm.globals.set(\"randomNum2\", _.random(0, 9));",
                      "pm.globals.set(\"randomNum3\", _.random(0, 9));"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "// 1. 取得 Response Header 中的 x-token",
                      "const xToken = pm.response.headers.get(\"x-token\");",
                      "",
                      "// 2. 檢查是否有抓到值",
                      "if (xToken) {",
                      "    // 3. 將其存入環境變數 (Environment Variable)",
                      "    pm.environment.set(\"x-token\", xToken);",
                      "    console.log(\"成功存入 x-token: \" + xToken);",
                      "} else {",
                      "    console.warn(\"找不到 x-token header\");",
                      "}"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
