LOG_LEVEL=debug
SERVER_PORT=8081
ENVIRONMENT=local
GO_NODE=1

DB_USER=root
DB_PASS=123456
DB_HOST=mysql
DB_PORT=3306
DB_NAME=easy_vault
DB_TYPE=mysql
DB_TIMEZONE_OFFSET=0

DB_SLAVE_HOSTS=mysql
DB_SLAVE_PORTS=3306
DB_SLAVE_USERNAMES=root
DB_SLAVE_PASSWORDS=123456

DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=3600s
DB_CONN_MAX_IDLE_TIME=0s

REDIS_ADDR=redis:6379
REDIS_PWD=123456
REDIS_DB=0
REDIS_POOL=100
REDIS_TLS=false

MQ_LIST=
MQ_PUBSUB=pubsub:websocket

L2_CACHE_EXPIRE=600s

WORKER_POOL_SIZE=128
DEFAULT_WORKER_SIZE=128

WS_SERVER_PORT=9443
BUCKET_SIZE=4
WRITE_WAIT=5000ms
PONG_WAIT=60000ms
PING_PERIOD=10000ms
MAX_MESSAGE_SIZE=1048576
READ_BUFFER_SIZE=1024
WRITE_BUFFER_SIZE=1024
BROADCAST_SIZE=128

SALT_LENGTH=8
TOKEN_EXPIRE_TIME=98h
LOGIN_DATA_EXPIRE_TIME=196h

I18N_CONFIG_PATH=./lang/

LOCK_DURATION=100000000us
LOCK_WAIT_DURATION=8000000us

PREVIEW_EXPIRY_TIME=900s

SENTRY_DSN=
TIMEZONE=UTC
MAX_MULTIPART_MEMORY=10485760
