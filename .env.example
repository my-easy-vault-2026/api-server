SERVER_PORT=8099
ENVIRONMENT=dev

DB_HOST=127.0.0.1
DB_PORT=3311
DB_NAME=main
DB_USER=root
DB_PASS=123456

# 從庫 (Slaves - 讀) - 支持多個，逗號分隔
DB_SLAVE_HOSTS=127.0.0.1,127.0.0.1

# 從庫端口 (可選，不設置則使用主庫端口)
DB_SLAVE_PORTS=3311,3311

# 從庫用戶名 (可選，不設置則使用主庫用戶名)
# DB_SLAVE_USERNAMES=readonly,readonly,readonly

# 從庫密碼 (可選，不設置則使用主庫密碼)
# DB_SLAVE_PASSWORDS=readpass,readpass,readpass

# 連接池配置
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=3600s  # 1小時
DB_CONN_MAX_IDLE_TIME=600s  # 10分鐘

# Redis 配置
REDIS_ADDR=127.0.0.1:6379
REDIS_PWD=123456
REDIS_DB=0
REDIS_POOL=100
REDIS_TLS=TLSv1.2